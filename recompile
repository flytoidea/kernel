# Set config and patch paths
current_path="${PWD}"
config_path="${current_path}/compile-kernel/tools/config"
kernel_patch_path="${current_path}/compile-kernel/tools/patch"

# Set Docker host mount directory and image
docker_hostpath="${PWD}"
docker_image="ophub/armbian-trixie:arm64"
docker_container="armbian-ophub"
docker_script="/usr/sbin/armbian-kernel"

# Get host architecture and release info
arch_info="$(uname -m)"
host_id="$(cat /etc/os-release 2>/dev/null | grep '^ID=.*' | cut -d'=' -f2)"
host_release="$(cat /etc/os-release 2>/dev/null | grep '^VERSION_CODENAME=.*' | cut -d'=' -f2)"

# 新增：内核版本变量和传递参数
kernel_version=""
pass_args=()  # 传递给容器内编译脚本的参数

# ======================== DTS路径配置 - 请根据实际情况修改 ========================
# 格式: "源目录名:目标目录路径"
# 注意：源目录是相对于 custom-dts/linux-${kernel_version}/ 的，目标目录是相对于内核源码的

# DTS源根目录
DTS_SOURCE_ROOT="${current_path}/custom-dts"

# DTS配置数组 - 每个条目定义一个需要处理的目录
DTS_CONFIGS=(
    # 示例格式: "源目录名:目标目录路径"
    "rockchip:arch/arm64/boot/dts/rockchip"
    "amlogic:arch/arm64/boot/dts/amlogic"
    "allwinner:arch/arm/boot/dts"
    "allwinner64:arch/arm64/boot/dts/allwinner"
    
    # 您可以在这里添加更多配置，每行一个
    # "your_soc_source:your_target_path"
)

# 是否启用DTS注入（默认启用）
ENABLE_DTS_INJECTION=true

# Set font color
STEPS="[\033[95m STEPS \033[0m]"
INFO="[\033[94m INFO \033[0m]"
SUCCESS="[\033[92m SUCCESS \033[0m]"
WARNING="[\033[93m WARNING \033[0m]"
ERROR="[\033[91m ERROR \033[0m]"
#
#==============================================================================================

error_msg() {
    echo -e "${ERROR} ${1}"
    exit 1
}

show_help() {
    cat << EOF
Usage: sudo ./recompile [OPTIONS]

Compile the kernel with Armbian Docker container.

Options:
  -k VERSION    Kernel version (e.g., 6.1.y, 5.10.y)
  -a            Auto use the latest kernel (true/false)
  -n            Kernel custom signature
  -m            Compile package list (all/dtbs)
  -p            Use kernel patches (true/false)
  -r            Kernel repository
  -t            Compilation toolchain
  -c            Clear ccache (true/false)
  -d            Delete kernel source after compilation (true/false)
  -s            Silent log output (true/false)
  -z            Initrd compression format
  -l            Output logs to file (true/false)
  -f            Kernel config flavor
  -H PATH       Docker host mount directory (default: ${PWD})
  -I IMAGE      Docker image (default: ophub/armbian-trixie:arm64)

DTS Injection Configuration (修改脚本中的DTS_CONFIGS数组):
  源目录结构: ${DTS_SOURCE_ROOT}/linux-\${kernel_version}/\${source_dir}/
  目标路径: /opt/kernel/linux-source/\${target_dir}/

Examples:
  sudo ./recompile -k 6.1.y -m all
  sudo ./recompile -k 5.10.y -m dtbs

EOF
    exit 0
}

init_var() {
    echo -e "${STEPS} 初始化变量..."
    
    # 显示帮助信息
    for arg in "$@"; do
        if [[ "${arg}" == "-h" || "${arg}" == "--help" ]]; then
            show_help
        fi
    done
    
    # 解析参数
    local options="k:a:n:m:p:r:t:c:d:s:z:l:f:H:I:h"
    parsed_args=$(getopt -o "${options}" -- "$@")
    [[ ${?} -ne 0 ]] && error_msg "参数解析失败。请使用 -h 查看帮助信息。"
    eval set -- "${parsed_args}"

    while true; do
        case "${1}" in
        -k)
            kernel_version="${2}"
            echo -e "${INFO} 内核版本: ${kernel_version}"
            pass_args+=("-k" "${2}")
            shift 2
            ;;
        -H)
            docker_hostpath="${2}"
            echo -e "${INFO} Docker主机挂载目录: ${docker_hostpath}"
            shift 2
            ;;
        -I)
            docker_image="${2}"
            echo -e "${INFO} Docker镜像: ${docker_image}"
            shift 2
            ;;
        # 其他参数直接传递给容器内编译脚本
        -a|-n|-m|-p|-r|-t|-c|-d|-s|-z|-l|-f)
            pass_args+=("${1}" "${2}")
            shift 2
            ;;
        -h)
            show_help
            ;;
        --)
            shift
            break
            ;;
        *)
            [[ -n "${1}" ]] && error_msg "无效选项: ${1}"
            break
            ;;
        esac
    done
    
    # 规范化内核版本
    if [[ -z "${kernel_version}" ]]; then
        kernel_version="6.1.y"  # 默认版本
        echo -e "${WARNING} 未指定内核版本，使用默认: ${kernel_version}"
        pass_args+=("-k" "${kernel_version}")
    fi
    
    # 验证内核版本格式
    if [[ ! "${kernel_version}" =~ ^[0-9]+\.[0-9]+\.y$ ]]; then
        echo -e "${WARNING} 内核版本格式不标准: ${kernel_version}"
        echo -e "${INFO} 尝试修复格式..."
        if [[ "${kernel_version}" =~ ^([0-9]+\.[0-9]+) ]]; then
            kernel_version="${BASH_REMATCH[1]}.y"
            echo -e "${INFO} 修复后版本: ${kernel_version}"
        fi
    fi
    
    # 检查DTS源目录是否存在
    local dts_source_dir="${DTS_SOURCE_ROOT}/linux-${kernel_version}"
    if [[ ! -d "${dts_source_dir}" ]] && [[ "${ENABLE_DTS_INJECTION}" == "true" ]]; then
        echo -e "${WARNING} DTS源目录不存在: ${dts_source_dir}"
        echo -e "${INFO} 跳过DTS注入"
        ENABLE_DTS_INJECTION=false
    fi
}

install_docker_engine() {
    echo -e "${STEPS} 安装Docker引擎..."
    
    if command -v docker &>/dev/null; then
        echo -e "${INFO} Docker已安装"
        return 0
    fi
    
    echo -e "${INFO} 正在安装Docker..."
    
    # 安装Docker
    if ! curl -fsSL https://get.docker.com | sh; then
        error_msg "Docker安装失败"
    fi
    
    # 添加当前用户到docker组
    if ! usermod -aG docker "${USER}"; then
        echo -e "${WARNING} 无法将用户添加到docker组，可能需要手动执行: sudo usermod -aG docker ${USER}"
    else
        echo -e "${INFO} 已将用户 ${USER} 添加到docker组"
        echo -e "${WARNING} 需要重新登录或重启终端才能使组更改生效"
        echo -e "${INFO} 或者执行: newgrp docker"
    fi
    
    # 启动Docker服务
    systemctl enable --now docker
}

launch_docker_container() {
    echo -e "${STEPS} 启动Armbian Docker容器..."
    
    # 检查容器是否已经在运行
    if docker ps -q -f name="${docker_container}" | grep -q .; then
        echo -e "${INFO} Docker容器 [${docker_container}] 正在运行"
        return 0
    fi
    
    # 移除已停止的容器
    if docker ps -aq -f status=exited -f name="${docker_container}" | grep -q .; then
        echo -e "${INFO} 移除已停止的容器 [${docker_container}]..."
        docker rm -f "${docker_container}" >/dev/null 2>&1
    fi
    
    # 启用QEMU多架构模拟
    echo -e "${INFO} 启用QEMU多架构模拟..."
    if ! docker run --rm --privileged multiarch/qemu-user-static --reset -p yes; then
        echo -e "${ERROR} QEMU模拟启用失败，arm64架构编译可能无法工作"
        echo -e "${INFO} 尝试继续执行..."
    fi
    
    # 设置Docker挂载路径
    echo -e "${INFO} 设置Docker挂载路径..."
    compile_path="${docker_hostpath}/compile-kernel"
    ccache_path="${docker_hostpath}/ccache"
    mkdir -p "${compile_path}" "${ccache_path}"
    
    # 拉取Armbian Docker镜像
    echo -e "${INFO} 拉取Docker镜像: [${docker_image}]..."
    if ! docker pull "${docker_image}"; then
        error_msg "无法拉取Docker镜像: ${docker_image}"
    fi
    
    # 运行容器
    echo -e "${INFO} 启动Docker容器..."
    if ! docker run -d --privileged \
        --name "${docker_container}" \
        -v "${compile_path}:/opt/kernel/compile-kernel" \
        -v "${ccache_path}:/root/.ccache" \
        -v /etc/localtime:/etc/localtime:ro \
        -v /etc/timezone:/etc/timezone:ro \
        -e CCACHE_DIR=/root/.ccache \
        --restart=always \
        "${docker_image}"; then
        error_msg "无法启动Docker容器"
    fi
    
    echo -e "${SUCCESS} Docker容器启动成功"
}

wait_for_docker_ready() {
    echo -e "${INFO} 等待Docker容器就绪..."
    
    local max_retries=30
    local retry_count=0
    
    while [[ ${retry_count} -lt ${max_retries} ]]; do
        # 检查容器是否正在运行
        if ! docker ps -q -f name="${docker_container}" | grep -q .; then
            echo -e "${WARNING} 容器未运行，等待... (${retry_count}/${max_retries})"
            sleep 2
            ((retry_count++))
            continue
        fi
        
        # 检查容器内服务是否就绪
        if docker exec -i "${docker_container}" sh -c "test -f ${docker_script}" 2>/dev/null; then
            echo -e "${SUCCESS} Docker容器已就绪"
            return 0
        fi
        
        echo -e "${INFO} 等待容器内服务启动... (${retry_count}/${max_retries})"
        sleep 2
        ((retry_count++))
    done
    
    error_msg "Docker容器在 ${max_retries} 秒后仍未就绪"
}

# =============================== DTS注入函数 ===============================

# 获取容器内的内核源码路径
get_kernel_source_dir() {
    local kernel_dir=""
    
    # 尝试多种方法获取内核源码路径
    echo -e "${INFO} 查找内核源码目录..."
    
    # 方法1: 查找最新拉取的内核源码
    kernel_dir=$(docker exec -i "${docker_container}" \
        find /opt/kernel -type d -name "linux-*" 2>/dev/null | \
        sort -r | head -1)
    
    # 方法2: 通过compile-kernel目录查找
    if [[ -z "${kernel_dir}" ]]; then
        kernel_dir=$(docker exec -i "${docker_container}" \
            find /opt/kernel/compile-kernel -type d -name "linux-*" 2>/dev/null | \
            sort -r | head -1)
    fi
    
    # 方法3: 使用容器内的默认路径
    if [[ -z "${kernel_dir}" ]]; then
        # ophub容器中内核源码的标准路径
        kernel_dir="/opt/kernel/compile-kernel/output/sources/linux-${kernel_version%.y}"
        echo -e "${WARNING} 使用默认内核源码路径: ${kernel_dir}"
    else
        echo -e "${INFO} 找到内核源码目录: ${kernel_dir}"
    fi
    
    # 验证目录是否存在
    if ! docker exec -i "${docker_container}" test -d "${kernel_dir}" 2>/dev/null; then
        echo -e "${WARNING} 内核源码目录不存在: ${kernel_dir}"
        echo -e "${INFO} 尝试创建或等待目录..."
        docker exec -i "${docker_container}" mkdir -p "${kernel_dir}" 2>/dev/null
    fi
    
    echo "${kernel_dir}"
}

# 查找Makefile中的dtb前缀
find_makefile_prefix() {
    local makefile_path="$1"
    local prefix=""
    
    # 读取Makefile内容
    local makefile_content=$(docker exec -i "${docker_container}" cat "${makefile_path}" 2>/dev/null)
    
    if [[ -z "${makefile_content}" ]]; then
        echo ""
        return 1
    fi
    
    # 查找包含 dtb-$(CONFIG_ 的行
    while IFS= read -r line; do
        # 跳过注释行和空行
        [[ "${line}" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line}" ]] && continue
        
        # 匹配 dtb-$(CONFIG_XXX) += 格式
        if [[ "${line}" =~ ^[[:space:]]*(dtb-\$\(CONFIG_[A-Za-z0-9_]+\))[[:space:]]*\+=[[:space:]] ]]; then
            prefix="${BASH_REMATCH[1]}"
            break
        fi
    done <<< "${makefile_content}"
    
    echo "${prefix}"
}

# 检查是否已在Makefile中存在
check_exists_in_makefile() {
    local makefile_path="$1"
    local line="$2"
    
    # 使用grep检查是否存在完全相同的行（忽略行首尾空白）
    local exists=$(docker exec -i "${docker_container}" \
        grep -c "^[[:space:]]*${line}[[:space:]]*$" "${makefile_path}" 2>/dev/null || echo "0")
    
    [[ "${exists}" -gt 0 ]] && return 0 || return 1
}

# DTS注入主函数
inject_custom_dts() {
    if [[ "${ENABLE_DTS_INJECTION}" != "true" ]]; then
        echo -e "${INFO} DTS注入已禁用，跳过"
        return 0
    fi
    
    echo -e "${STEPS} 开始注入自定义DTS文件..."
    
    # 1. 根据内核版本确定DTS源目录
    local dts_source_dir="${DTS_SOURCE_ROOT}/linux-${kernel_version}"
    
    if [[ ! -d "${dts_source_dir}" ]]; then
        echo -e "${ERROR} DTS源目录不存在: ${dts_source_dir}"
        return 1
    fi
    
    echo -e "${INFO} DTS源目录: ${dts_source_dir}"
    
    # 2. 获取容器内的内核源码路径
    local kernel_dir=$(get_kernel_source_dir)
    if [[ -z "${kernel_dir}" ]]; then
        echo -e "${ERROR} 无法获取内核源码路径"
        return 1
    fi
    
    echo -e "${INFO} 内核源码目录: ${kernel_dir}"
    
    # 3. 遍历所有配置的路径
    local total_configs=${#DTS_CONFIGS[@]}
    local processed_configs=0
    local total_injected=0
    local total_skipped=0
    local total_failed=0
    
    for config in "${DTS_CONFIGS[@]}"; do
        ((processed_configs++))
        echo -e "\n${INFO} 处理配置 [${processed_configs}/${total_configs}]: ${config}"
        
        # 解析配置：源目录名:目标目录路径
        local source_dir=$(echo "${config}" | cut -d':' -f1)
        local target_dir=$(echo "${config}" | cut -d':' -f2)
        
        # 完整的源路径和目标路径
        local full_source_path="${dts_source_dir}/${source_dir}"
        local full_target_path="${kernel_dir}/${target_dir}"
        
        echo -e "  源路径: ${full_source_path}"
        echo -e "  目标路径: ${full_target_path}"
        
        # 检查源目录是否存在
        if [[ ! -d "${full_source_path}" ]]; then
            echo -e "  ${WARNING} 源目录不存在，跳过"
            continue
        fi
        
        # 使用nullglob避免无文件时的通配符扩展问题
        shopt -s nullglob
        
        # 获取所有.dts和.dtsi文件
        local dts_files=("${full_source_path}"/*.dts)
        local dtsi_files=("${full_source_path}"/*.dtsi)
        
        # 重置nullglob
        shopt -u nullglob
        
        # 检查是否有dts或dtsi文件
        if [[ ${#dts_files[@]} -eq 0 && ${#dtsi_files[@]} -eq 0 ]]; then
            echo -e "  ${WARNING} 没有找到.dts或.dtsi文件，跳过"
            continue
        fi
        
        # 4. 创建目标目录
        echo -e "  ${INFO} 创建目标目录..."
        if ! docker exec -i "${docker_container}" mkdir -p "${full_target_path}" 2>/dev/null; then
            echo -e "  ${ERROR} 无法创建目标目录: ${full_target_path}"
            ((total_failed++))
            continue
        fi
        
        # 5. 复制所有.dts和.dtsi文件
        local file_count=0
        
        # 复制.dts文件
        for dts_file in "${dts_files[@]}"; do
            local filename=$(basename "${dts_file}")
            local target_file="${full_target_path}/${filename}"
            
            echo -e "  ${INFO} 复制: ${filename}"
            if docker cp "${dts_file}" "${docker_container}:${target_file}" 2>/dev/null; then
                echo -e "    ${SUCCESS} 成功"
                ((file_count++))
                ((total_injected++))
            else
                echo -e "    ${ERROR} 失败"
                ((total_failed++))
            fi
        done
        
        # 复制.dtsi文件
        for dtsi_file in "${dtsi_files[@]}"; do
            local filename=$(basename "${dtsi_file}")
            local target_file="${full_target_path}/${filename}"
            
            echo -e "  ${INFO} 复制头文件: ${filename}"
            if docker cp "${dtsi_file}" "${docker_container}:${target_file}" 2>/dev/null; then
                echo -e "    ${SUCCESS} 成功"
                ((file_count++))
                ((total_injected++))
            else
                echo -e "    ${ERROR} 失败"
                ((total_failed++))
            fi
        done
        
        # 6. 更新Makefile（只针对.dts文件）
        if [[ ${#dts_files[@]} -gt 0 ]]; then
            echo -e "  ${INFO} 开始更新Makefile..."
            
            # 获取目标Makefile路径
            local makefile_path="${full_target_path}/Makefile"
            
            # 检查Makefile是否存在
            if ! docker exec -i "${docker_container}" test -f "${makefile_path}" 2>/dev/null; then
                echo -e "  ${WARNING} Makefile不存在: ${makefile_path}"
                echo -e "  ${INFO} 创建新的Makefile..."
                docker exec -i "${docker_container}" touch "${makefile_path}" 2>/dev/null
            fi
            
            # 查找Makefile前缀
            local prefix=$(find_makefile_prefix "${makefile_path}")
            
            if [[ -n "${prefix}" ]]; then
                echo -e "  ${INFO} 找到Makefile前缀: ${prefix}"
                
                # 对每个.dts文件单独处理
                for dts_file in "${dts_files[@]}"; do
                    local basename=$(basename "${dts_file}" .dts)
                    local new_line="${prefix} += ${basename}.dtb"
                    
                    # 检查是否已存在
                    if check_exists_in_makefile "${makefile_path}" "${new_line}"; then
                        echo -e "  ${WARNING} 已存在，跳过: ${new_line}"
                        ((total_skipped++))
                    else
                        # 在Makefile末尾添加新行
                        if docker exec -i "${docker_container}" sh -c "echo '${new_line}' >> '${makefile_path}'" 2>/dev/null; then
                            echo -e "  ${SUCCESS} 添加: ${new_line}"
                        else
                            echo -e "  ${ERROR} 添加失败: ${new_line}"
                            ((total_failed++))
                        fi
                    fi
                done
            else
                echo -e "  ${WARNING} 无法识别Makefile格式，跳过更新"
                echo -e "  ${INFO} 提示: Makefile应包含类似 'dtb-\$(CONFIG_XXX) +=' 的行"
            fi
        fi
        
        echo -e "  ${INFO} 已处理 ${file_count} 个文件"
    done
    
    # 7. 输出统计信息
    echo -e "\n${STEPS} DTS注入统计:"
    echo -e "  ${SUCCESS} 成功注入: ${total_injected} 个文件"
    echo -e "  ${WARNING} 跳过重复: ${total_skipped} 个条目"
    echo -e "  ${ERROR} 失败操作: ${total_failed} 个"
    
    if [[ ${total_failed} -eq 0 ]]; then
        echo -e "${SUCCESS} DTS注入完成"
        return 0
    else
        echo -e "${WARNING} DTS注入完成，但有失败项"
        return 1
    fi
}

# 安全同步配置文件
safe_sync_configs() {
    local source_dir="$1"
    local target_dir="$2"
    local description="$3"
    
    if [[ ! -d "${source_dir}" ]]; then
        echo -e "${INFO} 无${description}，跳过"
        return 0
    fi
    
    echo -e "${INFO} 同步${description}..."
    
    # 检查目标目录是否存在
    if ! docker exec -i "${docker_container}" test -d "${target_dir}" 2>/dev/null; then
        echo -e "${WARNING} 目标目录不存在: ${target_dir}"
        echo -e "${INFO} 创建目录..."
        docker exec -i "${docker_container}" mkdir -p "${target_dir}" 2>/dev/null
    fi
    
    # 备份原有文件（如果存在）
    local backup_dir="${target_dir}_backup_$(date +%Y%m%d_%H%M%S)"
    if docker exec -i "${docker_container}" test -d "${target_dir}" 2>/dev/null && \
       docker exec -i "${docker_container}" find "${target_dir}" -maxdepth 1 -type f | grep -q .; then
        echo -e "${INFO} 备份原有${description}..."
        docker exec -i "${docker_container}" cp -r "${target_dir}" "${backup_dir}" 2>/dev/null || true
    fi
    
    # 同步文件
    local file_count=$(find "${source_dir}" -type f | wc -l)
    if [[ ${file_count} -eq 0 ]]; then
        echo -e "${WARNING} 源目录中无${description}文件"
        return 0
    fi
    
    echo -e "${INFO} 找到 ${file_count} 个${description}文件"
    
    # 使用rsync风格复制，保留目录结构
    for file in "${source_dir}"/*; do
        if [[ -f "${file}" ]]; then
            local filename=$(basename "${file}")
            echo -e "  ${INFO} 同步: ${filename}"
            if docker cp "${file}" "${docker_container}:${target_dir}/${filename}" 2>/dev/null; then
                echo -e "    ${SUCCESS} 成功"
            else
                echo -e "    ${WARNING} 失败，可能已存在"
            fi
        fi
    done
    
    echo -e "${SUCCESS} ${description}同步完成"
}

configure_and_compile() {
    echo -e "${STEPS} 配置Docker环境并编译内核..."
    
    # 等待容器就绪
    wait_for_docker_ready
    
    # 同步服务器时间
    echo -e "${INFO} 同步服务器时间..."
    ntpdate ntp.ubuntu.com pool.ntp.org >/dev/null 2>&1 || true
    
    # 重启Docker容器以确保环境干净
    echo -e "${INFO} 重启Docker容器..."
    if ! docker restart "${docker_container}" >/dev/null; then
        echo -e "${WARNING} 容器重启失败，继续执行..."
    fi
    sleep 3
    wait_for_docker_ready
    
    # 同步容器内脚本
    echo -e "${INFO} 同步容器内脚本..."
    if ! docker exec -i "${docker_container}" bash "${docker_script}" -u; then
        echo -e "${WARNING} 脚本同步失败，继续执行..."
    fi
    
    # 安全同步自定义配置
    safe_sync_configs "${config_path}" "/opt/kernel/compile-kernel/tools/config" "自定义配置"
    
    # 安全同步自定义补丁
    safe_sync_configs "${kernel_patch_path}" "/opt/kernel/compile-kernel/tools/patch" "自定义补丁"
    
    # 注入自定义DTS文件
    inject_custom_dts
    
    # 开始编译内核
    echo -e "${STEPS} 开始在Docker容器内编译内核..."
    echo -e "${INFO} 编译参数: ${pass_args[*]}"
    
    # 记录开始时间
    local start_time=$(date +%s)
    
    # 执行编译
    if docker exec -i "${docker_container}" bash "${docker_script}" "${pass_args[@]}"; then
        local end_time=$(date +%s)
        local duration=$((end_time - start_time))
        echo -e "${SUCCESS} 内核编译成功完成!"
        echo -e "${INFO} 编译耗时: $((duration / 60))分$((duration % 60))秒"
        return 0
    else
        local end_time=$(date +%s)
        local duration=$((end_time - start_time))
        echo -e "${ERROR} 内核编译失败!"
        echo -e "${INFO} 编译耗时: $((duration / 60))分$((duration % 60))秒"
        return 1
    fi
}

# 清理函数
cleanup() {
    echo -e "\n${INFO} 清理中..."
    
    # 显示Docker容器状态
    echo -e "${INFO} Docker容器状态:"
    docker ps -a --filter "name=${docker_container}" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" || true
    
    # 显示主机空间使用情况
    echo -e "\n${INFO} 主机空间使用情况:"
    df -hT "${docker_hostpath}" | tail -1
    
    # 显示输出目录
    echo -e "\n${INFO} 输出目录内容:"
    ls -la "${docker_hostpath}/compile-kernel/output/" 2>/dev/null || echo "输出目录不存在"
}

# 主函数
main() {
    # 显示欢迎信息
    echo -e "${STEPS} 欢迎使用内核编译脚本"
    echo -e "${INFO} 主机环境 [ ${host_id}: ${host_release} / ${arch_info} ]"
    
    # 检查脚本权限
    if [[ "$(id -u)" != "0" ]]; then
        error_msg "请使用root权限运行此脚本: [ sudo ./$(basename "$0") ]"
    fi
    
    # 初始化变量
    init_var "$@"
    
    # 安装Docker引擎（如果未安装）
    install_docker_engine
    
    # 启动Docker容器
    launch_docker_container
    
    # 配置环境并编译内核
    if configure_and_compile; then
        echo -e "${SUCCESS} 所有流程成功完成!"
    else
        echo -e "${ERROR} 编译过程出现错误!"
    fi
    
    # 清理和状态检查
    cleanup
    
    # 根据编译结果退出
    if [[ $? -eq 0 ]]; then
        exit 0
    else
        exit 1
    fi
}

# 异常处理
trap 'echo -e "\n${ERROR} 脚本被中断"; exit 1' INT TERM

# 执行主函数
main "$@"
